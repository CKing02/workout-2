  <mxCell id="arrow_orange_lbl" value="错误流 (ErrorBoundary → error_logs → Diagnostics)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#EF6C00;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="450" y="1610" width="520" height="22" as="geometry" /></mxCell>
