  <mxCell id="arrow_purple_lbl" value="主题同步 (settingsStore.themeMode → ThemeProvider)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#6A1B9A;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="450" y="1640" width="520" height="22" as="geometry" /></mxCell>
