  <mxCell id="arrow_gray_lbl" value="普通依赖 / 调用 (imports · composition)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#546E7A;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="450" y="1670" width="520" height="22" as="geometry" /></mxCell>
  <mxCell id="notes_title" value="关键设计要点 · Key Design Notes" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#263238;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="1554" width="540" height="26" as="geometry" /></mxCell>
  <mxCell id="note_1584" value="1. 训练中只在内存操作 set 数组，&lt;b&gt;完成时一次性 batch insert&lt;/b&gt; (PRD 风险评估)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#37474F;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="1584" width="540" height="18" as="geometry" /></mxCell>
  <mxCell id="note_1602" value="2. completeTraining 用 &lt;b&gt;withTransactionAsync&lt;/b&gt; 保证 training 行 + set 行原子写入" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#37474F;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="1602" width="540" height="18" as="geometry" /></mxCell>
  <mxCell id="note_1620" value="3. &lt;b&gt;plan_name_snapshot / exercise_name_snapshot&lt;/b&gt; 删除 / 重命名不影响历史展示" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#37474F;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="1620" width="540" height="18" as="geometry" /></mxCell>
  <mxCell id="note_1638" value="4. &lt;b&gt;lastSetsByExerciseId&lt;/b&gt; (G17) 缓存最近 3 组，训练页一次性预查" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#37474F;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="1638" width="540" height="18" as="geometry" /></mxCell>
  <mxCell id="note_1656" value="5. &lt;b&gt;ActiveTraining / TrainingComplete&lt;/b&gt; 是 RootStack 同级，Tab 栏隐藏 (IMMERSIVE_ROUTES)" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#37474F;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="1656" width="540" height="18" as="geometry" /></mxCell>
  <mxCell id="note_1674" value="6. &lt;b&gt;ErrorBoundary + Toast + error_logs&lt;/b&gt; 三件套保证 G12 永不白屏" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#37474F;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="1674" width="540" height="18" as="geometry" /></mxCell>
  <mxCell id="note_1692" value="7. SQLite 启用 &lt;b&gt;PRAGMA foreign_keys = ON&lt;/b&gt;，cascade 删除依赖此配置" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#37474F;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="1692" width="540" height="18" as="geometry" /></mxCell>
  <mxCell id="note_1710" value="8. SQLiteProvider.onInit 桥接到 &lt;b&gt;setDatabaseInstance&lt;/b&gt; 单例，所有 repository 共享同一连接" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#37474F;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="980" y="1710" width="540" height="18" as="geometry" /></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
