<?xml version="1.0" encoding="utf-8"?>
<!--
  休息倒计时通知的内容区(自绘)。

  配合 DecoratedCustomViewStyle 使用:
    - 系统头部(应用图标 / 应用名 / 时间 / 圆角卡片)由 SystemUI 绘制
    - 本布局只画内容区:一行「动作名 + 倒计时」+ 进度条

  内容区由 RestTimerProgressModule.build() 组装,每次重建一份 RemoteViews;
  收起态和展开态传的是同一个对象 —— 展开后没有任何新内容可显示。

  2026-09-22 后台冻结修复:
    倒计时从 TextView 换成 <Chronometer>。TextView 的内容只能由 App 进程写,
    而退后台后 RN 的 JS 定时器会被暂停(Android cached-apps freezer 也会冻结进程),
    tick 停摆 → 通知定格在最后一帧,用户看到的是个假的剩余时间。
    Chronometer 是**由 SystemUI 自己每秒刷新**的,App 进程冻不冻结都照走 ——
    系统时钟 App 的计时通知用的就是这个机制。

  2026-09-28 进度条后台冻结修复:
    进度条**没有** Chronometer 那样的自走机制,值只能由 App 主动写
    (RemoteViews.setProgressBar)。所以上面那条修完之后,通知栏会出现
    "数字照走、进度条卡死"的自相矛盾画面(真机实测确认)。
    现在改由前台服务 RestTimerTickerService 每秒重画一次,进程不再被冻结,
    前台后台走同一条渲染路径。详见该类的注释。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingTop="2dp"
    android:paddingBottom="2dp">

  <!-- 动作名(左,占满剩余宽度) + 倒计时(右,固定最小宽度) -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">

    <!-- 动作名过长时截断,不换行 —— 通知栏只有一行的高度预算 -->
    <TextView
        android:id="@+id/rest_timer_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp" />

    <!--
      minWidth + 右对齐:数字每秒变化时宽度会变,不给最小宽度的话
      左边动作名会跟着左右抖动。
    -->
    <Chronometer
        android:id="@+id/rest_timer_chrono"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:minWidth="44dp"
        android:gravity="end"
        android:countDown="true"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="14sp" />

  </LinearLayout>

  <!-- 进度条着色由 Kotlin 侧 setProgressTintList 注入(主题 primary),不在这里写死 -->
  <ProgressBar
      android:id="@+id/rest_timer_progress"
      style="?android:attr/progressBarStyleHorizontal"
      android:layout_width="match_parent"
      android:layout_height="4dp"
      android:layout_marginTop="6dp"
      android:max="100" />

</LinearLayout>
