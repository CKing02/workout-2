<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!--
    休息到点提醒要准点响,走的是 setExactAndAllowWhileIdle。
    Android 12+ 起精确闹钟需要这个权限;targetSdk 33+ 时**默认不授予**,
    用户得去「系统设置 → 应用 → 特殊权限 → 闹钟和提醒」里手动开。
    拿不到时 RestTimerProgressModule.scheduleAlarm 会自动降级到非精确闹钟,
    所以缺了它最坏只是"提醒可能迟到",不会崩也不会没有提醒。
  -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

  <!--
    AlarmReceiver 到点时直接调 Vibrator service 强制震动,绕过通知 channel 路径。
    channel vibrate 在锁屏下会被 OPPO ColorOS / 小米 MIUI 等 OEM 拦截(标准 Android 不拦),
    但 Vibrator 是 system service 不会被拦截。普通权限,系统默认授予,无需运行时请求。
    "宁可多震一次也不要漏掉提醒"的取舍见 receiver 注释。
  -->
  <uses-permission android:name="android.permission.VIBRATE" />

  <!--
    前台服务:退后台后继续每秒重画通知栏进度条(见 RestTimerTickerService 注释)。
    FOREGROUND_SERVICE 是 API 28+ 的普通权限,系统自动授予。
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

  <!--
    API 34+ 起,foregroundServiceType="specialUse" 需要配套这个普通权限。
    低版本系统不认识它,声明了也无害(未知权限被忽略)。
  -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

  <application>
    <!--
      exported=false —— 这个 receiver 只应该被我们自己排的 PendingIntent 唤起。
      没有 intent-filter,靠显式 component 匹配。
    -->
    <receiver
        android:name="expo.modules.resttimerprogress.RestTimerAlarmReceiver"
        android:enabled="true"
        android:exported="false" />

    <!--
      休息倒计时 ticker。exported=false —— 只由本 App 的 startForegroundService 拉起。

      foregroundServiceType 必须声明:targetSdk 34+ 起,startForeground() 若找不到
      匹配的已声明类型会抛 MissingForegroundServiceTypeException,服务直接起不来。
      为什么选 specialUse 而不是 shortService:短服务的硬上限是 3 分钟,而本 App
      的休息时长预设最大 240s(PlanEditorScreen.tsx 的 REST_PRESETS),
      超时会走 onTimeout 强制收尾甚至崩溃,不能用一个会"到点自爆"的类型。

      <property> 里的 subtype 是 API 34+ 要求的用途说明(Play 审核也看它)。
    -->
    <service
        android:name="expo.modules.resttimerprogress.RestTimerTickerService"
        android:enabled="true"
        android:exported="false"
        android:foregroundServiceType="specialUse">
      <property
          android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="workout_rest_timer_countdown" />
    </service>
  </application>

</manifest>
